# ========== MySQL ==========
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=liveops
MYSQL_USER=liveops
MYSQL_PASSWORD=liveops123

# ========== PostgreSQL (Agent 记忆/决策/审计) ==========
POSTGRES_DB=agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent123

# ========== Redis ==========
REDIS_URL=redis://redis:6379/0

# ========== MinIO (Milvus 对象存储) ==========
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ========== 阿里云百炼 LLM (可选，留空自动降级为 jieba 规则分类) ==========
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MAIN_MODEL=qwen-max
LLM_LIGHT_MODEL=qwen-turbo
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ========== Milvus ==========
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ========== 后端连接 (容器内服务名) ==========
DATABASE_URL=mysql+pymysql://liveops:liveops123@mysql:3306/liveops?charset=utf8mb4
POSTGRES_URL=postgresql+psycopg2://agent:agent123@postgres:5432/agent

# ========== JWT ==========
JWT_SECRET=change-me-in-prod-please-use-random-string
JWT_EXPIRE_MINUTES=1440

# ========== 场控 Agent 预算护栏 ==========
COUPON_DAILY_BUDGET=5000.0
MAX_DANMAKU_PER_MINUTE=60
DANMAKU_RATE_LIMIT=20

# ========== 日志 ==========
LOG_LEVEL=INFO

# ========== 演示模式（自动注入弹幕、平滑在线人数、时间对齐当前时刻） ==========
DEMO_MODE=true
